NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY= 
# WhatsApp del coach, solo dígitos con código de país (ej. 573001112233)
NEXT_PUBLIC_COACH_WHATSAPP=

# Vídeo del reporte diario (Bunny Stream). SOLO en el servidor (Netlify → Environment variables). NUNCA con NEXT_PUBLIC_.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
# Opcional: clave "Token authentication" de la biblioteca (Security). Si no se pone, el reproductor usa enlace sin firmar.
BUNNY_TOKEN_KEY=
