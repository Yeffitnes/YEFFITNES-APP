NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY= 

# Vídeo del reporte diario (Bunny Stream). SOLO en el servidor (Netlify → Environment variables). NUNCA con NEXT_PUBLIC_.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
# Opcional: clave "Token authentication" de la biblioteca (Security). Si no se pone, el reproductor usa enlace sin firmar.
BUNNY_TOKEN_KEY=

# Avisos push (mensajes). Generar un par con: npx web-push generate-vapid-keys
# La pública va en NEXT_PUBLIC_ (se incrusta al construir); la privada SOLO en el servidor (Netlify).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@yeffitnes.com

# Obliga a usar la app instalada en celulares/tablets (en computador no bloquea). 1 = activo. Vacío = apagado.
NEXT_PUBLIC_REQUIRE_INSTALL=
# Nombre corto de la app instalada (solo en el sitio de pruebas: YEFFITNES Test).
NEXT_PUBLIC_APP_NAME=
